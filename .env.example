# Base URL of the DigitalSchoolManagementSystem.API project (see launchSettings.json).
# CORS on the backend is configured for http://localhost:5173 (Vite) - keep the frontend on that port,
# or add your port to Cors:AllowedOrigins in appsettings.json.
VITE_API_BASE_URL=http://localhost:5081/api
VITE_HUB_URL=http://localhost:5081/hubs/notifications
